# PMAI 环境变量配置
# 复制此文件为 .env 并填入你的密钥

# DeepSeek API (platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key

# Serper API — 新闻搜索 (serper.dev)
SERPER_API_KEY=your_serper_api_key

# Circle Developer Wallets — 代理金库 (console.circle.com)
CIRCLE_API_KEY=SANDOX_your_circle_api_key
ENTITY_SECRET=your_32_byte_hex_entity_secret

# Telegram 通知 (可选)
# @BotFather 创建 bot 获取 token
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Polymarket 私钥 — 仅真实交易需要 (可选)
POLYMARKET_PRIVATE_KEY=
