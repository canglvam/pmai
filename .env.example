# PMAI Environment Variables
# Copy this file to .env and fill in your keys

# DeepSeek API (platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key

# Serper API — Google News search (serper.dev)
SERPER_API_KEY=your_serper_api_key

# Circle Developer Wallets — agent treasury (console.circle.com)
CIRCLE_API_KEY=SANDOX_your_circle_api_key
ENTITY_SECRET=your_32_byte_hex_entity_secret

# Telegram notifications (optional)
# Create a bot via @BotFather to get the token
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Polymarket private key — live trading only (optional)
POLYMARKET_PRIVATE_KEY=
